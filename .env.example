# Aware Framework Configuration
# All env vars use the AWARE_ prefix

# Database
AWARE_DB_PATH=data/aware.db

# Embeddings (local or remote API-based)
AWARE_EMBEDDING_PROVIDER=local
AWARE_EMBEDDING_MODEL=all-MiniLM-L6-v2
AWARE_EMBEDDING_DIM=384
AWARE_EMBEDDING_API_BASE=https://api.openai.com/v1
AWARE_EMBEDDING_API_KEY=

# Vector Search
AWARE_VECTOR_TOP_K=20
AWARE_SIMILARITY_THRESHOLD=0.5

# Memory Lifecycle
AWARE_DECAY_RATE=0.1
AWARE_DECAY_INTERVAL_HOURS=24.0
AWARE_CONSOLIDATION_THRESHOLD=3

# Context Engineering
AWARE_CONTEXT_MAX_TOKENS=8000
AWARE_CONTEXT_COMPRESSION_THRESHOLD=0.8

# LLM
AWARE_LLM_MODEL=gpt-4o-mini
AWARE_LLM_API_KEY=
AWARE_LLM_API_BASE=
